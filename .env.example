# Environment variables for NovaLink HR Simulation Lab

# Database (PostgreSQL for Neon / Vercel Postgres / local PostgreSQL)
DATABASE_URL="postgresql://user:password@ep-sample-12345.eu-central-1.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-sample-12345.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# NextAuth Configuration
NEXTAUTH_SECRET="novalink_super_secret_session_jwt_key_at_least_32_characters"
NEXTAUTH_URL="http://localhost:3000"

# Trainer Faculty Invite Code (Used to authorize trainer/instructor account creation)
TRAINER_INVITE_CODE="NOVALINK_FACULTY_2026"


# Zero-Cost / Free AI Provider (Optional: Google Gemini Free Tier API Key)
# Get a free key at https://aistudio.google.com/ - or leave blank to use the built-in offline persona engine!
GOOGLE_GENERATIVE_AI_API_KEY=""
GEMINI_API_KEY=""
